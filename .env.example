# Local development defaults. Never copy production secrets into this file.
WIKI_AUTH_MODE=dev
WIKI_API_PORT=5174
WIKI_SYNC_PORT=2234
VITE_WIKI_SYNC_PORT=2234
# WIKI_DEV_ADMIN_EMAILS=operator@example.com
# WIKI_DATA_FILE=apps/server/.local/wiki-store.json
# WIKI_MEDIA_DIR=apps/server/.local/media

# Production database URL: replace every placeholder privately.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# JWT / Google mode
WIKI_JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://wiki.example.com/api/wiki/auth/google/callback
WIKI_SESSION_TTL=8h
WIKI_COOKIE_SECURE=1
